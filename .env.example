# spinqd server bind & endpoint settings
SPINQ_BIND_HOST=0.0.0.0
SPINQ_HTTPS_PORT=8443
SPINQ_MQTT_TLS_PORT=8883
# Hostname or IP returned to appliances during HTTPS /route dispatch
SPINQ_PUBLIC_HOST=common.iot.aic.lgthinq.com
SPINQ_CERTS_DIR=/data/certs
SPINQ_LOG_LEVEL=INFO

# Home Assistant Mosquitto MQTT broker connection
HA_MQTT_HOST=192.0.2.10
HA_MQTT_PORT=1883
HA_MQTT_USER=mqtt_user
HA_MQTT_PASSWORD=replace_with_mqtt_password
HA_MQTT_DISCOVERY_PREFIX=homeassistant

# Optional JSON mapping of known appliance IPs or device IDs to roles ("washer" | "dryer").
# Example:
# SPINQ_KNOWN_APPLIANCES={"192.0.2.20":"washer","192.0.2.21":"dryer"}
SPINQ_KNOWN_APPLIANCES={}
